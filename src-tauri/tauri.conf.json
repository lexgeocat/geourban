{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "geourban",
  "version": "0.1.0",
  "identifier": "com.geourban.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GeoUrban",
        "width": 1400,
        "height": 900,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:", "https://*.google.com", "https://*.googleapis.com", "https://tile.openstreetmap.org", "https://*.arcgisonline.com"],
        "connect-src": ["'self'", "https://*.google.com", "https://*.googleapis.com", "https://tile.openstreetmap.org", "https://*.arcgisonline.com"],
        "worker-src": ["'self'", "blob:"],
        "font-src": ["'self'", "data:"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

